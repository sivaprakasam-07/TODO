rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile isolation
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Task collection isolation
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Reminder records isolation
      match /reminders/{reminderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Push notification token registrations isolation
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Collection group rule for reminders (ensures user can only query their own reminders)
    match /{path=**}/reminders/{reminderId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
